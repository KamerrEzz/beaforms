---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={title}>
  <div style="display:flex;min-height:100vh;">
    <aside style="width:240px;background:var(--color-surface);border-right:1px solid var(--color-border);padding:1.5rem 0;">
      <div style="padding:0 1.5rem;margin-bottom:2rem;">
        <a href="/" style="font-size:1.25rem;font-weight:700;color:var(--color-text);text-decoration:none;">
          Goodform
        </a>
      </div>
      <nav>
        <ul style="list-style:none;">
          <li>
            <a
              href="/forms"
              style={`display:block;padding:0.5rem 1.5rem;color:${currentPath.startsWith('/forms') ? 'var(--color-primary)' : 'var(--color-text-muted)'};text-decoration:none;font-size:0.875rem;font-weight:${currentPath.startsWith('/forms') ? '600' : '400'};`}
            >
              Forms
            </a>
          </li>
        </ul>
      </nav>
    </aside>
    <main style="flex:1;padding:2rem;">
      <slot />
    </main>
  </div>
</BaseLayout>
