---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getSessionUser } from '../../../auth/middleware';
import { getForm, publishForm } from '../../../actions/forms';
import { authorize } from '../../../domain/authorization';
import { db } from '../../../lib/db';

const user = await getSessionUser(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const formId = Astro.params.id;
if (!formId) {
  return Astro.redirect('/forms');
}

const formRecord = await db.form.findUnique({
  where: { id: formId },
  select: { organizationId: true },
});

if (!formRecord) {
  return Astro.redirect('/forms');
}

try {
  authorize(user, 'forms.get', formRecord.organizationId);
} catch {
  return Astro.redirect('/forms');
}

const result = await getForm(formId, user.organizationId);
const formData = 'form' in result.body ? result.body as { form: Record<string, unknown>; questions: Array<Record<string, unknown>>; rules: unknown[] } : null;

if (!formData) {
  return Astro.redirect('/forms');
}

// Handle publish action.
if (Astro.request.method === 'POST') {
  const publishResult = await publishForm(formId, user.userId, user.role, user.organizationId);
  if (publishResult.status === 200) {
    return Astro.redirect(`/forms/${formId}`);
  }
}
---
<DashboardLayout title={`${formData.form.title} - Goodform`}>
  <div class="card-header" style="margin-bottom:1.5rem;">
    <div>
      <a href="/forms" class="text-muted text-sm">&larr; Back to forms</a>
      <h1 style="font-size:1.5rem;font-weight:700;margin-top:0.25rem;">{String(formData.form.title)}</h1>
    </div>
    <div class="flex gap-2">
      <span class:list={['badge', formData.form.status === 'Published' ? 'badge-published' : formData.form.status === 'Archived' ? 'badge-archived' : 'badge-draft']}>
        {String(formData.form.status)} v{String(formData.form.version)}
      </span>
      {formData.form.status === 'Draft' && (
        <form method="post">
          <button type="submit" class="btn">Publish</button>
        </form>
      )}
    </div>
  </div>

  <div class="form-detail-grid">
    <div>
      <h2 style="font-size:1rem;font-weight:600;margin-bottom:1rem;">Questions</h2>
      {formData.questions.length === 0 ? (
        <div class="card" style="border-style:dashed;text-align:center;color:var(--color-text-muted);">
          No questions yet. Add questions to build your form.
        </div>
      ) : (
        <div class="stack">
          {formData.questions.map((q, i) => (
            <div class="card flex items-center justify-between" style="padding:1rem;background:var(--color-surface);">
              <div>
                <span style="font-weight:500;">{q.settings?.label ? String(q.settings.label) : ('Question ' + String(i + 1))}</span>
                <span class="text-muted text-sm" style="margin-left:0.5rem;">({String(q.type)})</span>
                {q.required && <span style="margin-left:0.25rem;color:var(--color-error);">*</span>}
              </div>
              <span class="text-muted text-xs">#{String(q.order)}</span>
            </div>
          ))}
        </div>
      )}
    </div>

    <div>
      <h2 style="font-size:1rem;font-weight:600;margin-bottom:1rem;">Settings</h2>
      <div class="card stack" style="gap:0.75rem;">
        <div>
          <span class="text-muted text-sm">Form ID</span>
          <div style="font-family:monospace;font-size:0.875rem;word-break:break-all;">{formId}</div>
        </div>
        <div>
          <span class="text-muted text-sm">Public URL</span>
          <div style="font-family:monospace;font-size:0.875rem;">
            <a href={`/f/${formData.form.id}`} target="_blank">/f/{String(formData.form.id)}</a>
          </div>
        </div>
        <div>
          <span class="text-muted text-sm">Questions</span>
          <div style="font-size:0.875rem;">{formData.questions.length}</div>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .form-detail-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .form-detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
